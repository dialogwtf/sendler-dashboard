# MongoDB the indexer writes to and the API reads from
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=near_indexer

# neardata block API (https://github.com/fastnear/neardata-server). The key is optional.
NEAR_DATA_API=https://mainnet.neardata.xyz/v0
NEAR_DATA_API_KEY=

# Token metadata only (ft_metadata view, once per token); USD rates come from REF Finance
# NEAR_RPC_URL=https://free.rpc.fastnear.com
# REF_PRICES_URL=https://api.ref.finance/list-token-price

# /health and /metrics
HEALTH_PORT=8080

# Worker knobs (defaults shown)
# DASH_ENABLED=true
# DASH_SMART_MONEY=true
# DASH_LAUNCH_STATS=true
# DASH_REFERENCE=true
# DASH_QUEUE=2000
# DASH_GAP_MAX=600
# DASH_TRADE_MIN_NEAR=0.05
# DASH_TRADES_TTL_DAYS=7
