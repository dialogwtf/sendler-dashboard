# MongoDB the indexer writes to (database name: near_indexer)
MONGO_URI=mongodb://localhost:27017/

# NEAR RPC, comma-separated for failover — used once per wallet sign-in (view_access_key)
# NEAR_RPC_URL=https://rpc.mainnet.near.org

# Browser origins allowed by CORS
# CORS_ORIGINS=https://dash.sendler.xyz,http://localhost:5173

# Behind a reverse proxy: its IPs/CIDRs, so the rate limit sees the real client IP
# TRUSTED_PROXY_IPS=

# Link previews and sign-in
# DASH_SITE_URL=https://dash.sendler.xyz
# DASH_API_URL=https://api.sendler.xyz
# DASH_SITE_INDEX=/path/to/web/dist/index.html
# DASH_BOT_USERNAME=sendler_trade_bot

# Optional: put the dashboard behind X-API-Key
# ALLOWED_API_KEYS=
# DASH_REQUIRE_API_KEY=0
